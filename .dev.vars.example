# Cloudflare Worker 本地反馈邮件配置。复制为 .dev.vars 后填写真实值。
RESEND_API_KEY=re_replace_with_your_key
FEEDBACK_TO_EMAIL=owner@example.com
FEEDBACK_RATE_LIMIT_SECRET=replace_with_a_random_32_byte_secret

# 可选。允许从其他站点提交反馈，多个来源用英文逗号分隔。
# FEEDBACK_ALLOWED_ORIGINS=https://blog.example.com

# 可选。全站每天最多发送的反馈邮件数，默认 50。
# FEEDBACK_DAILY_LIMIT=50

# 可选。未设置时使用 Resend 的测试发件地址。
# FEEDBACK_FROM_EMAIL=乐队后台 <feedback@your-verified-domain.example>
